# Copy this file to .env. URLs must be supplied by your providers.
# MODE=paper never reads a private key or broadcasts a transaction.
MODE=paper
RPC_URLS=https://primary-rpc.example,https://secondary-rpc.example
WS_URLS=wss://primary-rpc.example,wss://secondary-rpc.example
YELLOWSTONE_URL=
YELLOWSTONE_TOKEN=
# Reserved for the legacy local-keypair design. It is not a production signing
# path: current live startup fails closed until an isolated durable signer exists.
KEYPAIR_PATH=
DB_PATH=fusion-paper.sqlite
# Paper/observation-only override for unclassified storage. Set only after verifying
# local, single-host SQLite WAL behavior. This is not a durability proof. The terminal
# launcher reads this from its process environment; it does not load this file.
# DATABASE_FILESYSTEM_OPERATOR_ATTESTATION=LOCAL_SINGLE_HOST_WAL_COMPATIBLE
UI_PORT=8787

# Terminal and legacy market adapters do not use public endpoint fallbacks.
# Supply explicit provider endpoints before starting those adapters.
MARKET_RPC_URL=https://your-rpc-provider.example
RUGCHECK_URL=https://your-rugcheck-provider.example/v1/tokens
DEXSCREENER_URL=https://your-market-data-provider.example
KOLSCAN_URL=https://your-wallet-flow-provider.example
PUMPPORTAL_WS_URL=wss://your-discovery-stream-provider.example

# All money values below are integer lamports; 1 SOL = 1000000000 lamports.
BUY_LAMPORTS=10000000
PAPER_CASH_LAMPORTS=1000000000
MAX_POSITIONS=3
MAX_EXPOSURE_LAMPORTS=100000000
MAX_DAILY_LOSS_LAMPORTS=30000000
# Entry risk is capped at 50-150 bps of available cash (default 100 = 1%).
MAX_SPECULATIVE_RISK_BPS=100
# Rolling circuit breaker: default 5% drawdown or 3 failures within one hour.
ROLLING_DRAWDOWN_BPS=500
FAILURE_HALT_COUNT=3
FAILURE_WINDOW_MS=3600000
RESERVE_LAMPORTS=30000000

# Basis points: 100 bps = 1%. Panic still has a finite slippage cap.
SLIPPAGE_BPS=300
PANIC_SLIPPAGE_BPS=1000
MAX_IMPACT_BPS=500
MAX_FEE_BPS=300
MIN_BUYERS=5
MIN_AGE_MS=10000
MAX_AGE_MS=180000
MIN_CREATOR_LAMPORTS=1000000
MAX_CREATOR_BPS=500
MAX_TOP_TEN_BPS=3000
MIN_REAL_RESERVE_LAMPORTS=1000000000
LIQUIDITY_DROP_BPS=2500
STOP_BPS=1200

FEED_STALE_MS=10000
QUOTE_MAX_AGE_MS=3000
RPC_TIMEOUT_MS=4000
POLL_MS=1000
MAX_TRACKED=500
MAX_QUEUE=32

MIN_TIP_LAMPORTS=10000
MAX_TIP_LAMPORTS=500000
MAX_PRIORITY_LAMPORTS=200000
JITO_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles
JITO_AUTH=
RUGCHECK_MAX_SCORE=1000
JUPITER_URL=https://api.jup.ag/swap/v2
JUPITER_API_KEY=

# Optional hosted System-One research adapter. This remains advisory-only and
# does not grant trade, capital, signer, or release authority.
TYPESAFE_API_KEY=
TYPESAFE_JEV_TIMEOUT_MS=1500
