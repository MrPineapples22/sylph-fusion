{
  "name": "sylph-fusion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build:engine": "node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "build:ui": "npm --prefix terminal run build",
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.json && npm --prefix terminal run build",
    "test:core": "node --test --test-isolation=none test/*.test.mjs",
    "test:intelligence": "node --test --test-isolation=none test/intelligence/*.test.mjs",
    "test:platform": "node --test --test-isolation=none test/platform/*.test.mjs",
    "test:terminal": "node --test --test-isolation=none terminal/test/*.test.mjs",
    "test:connectivity": "node --test test/connectivity-static-core.test.mjs test/connectivity-compiler.test.mjs",
    "test:certification": "node --test --test-isolation=none test/canonicalization-v10.test.mjs test/connectivity-compiler.test.mjs test/certification-manifest.test.mjs test/canary-campaign-verifier.test.mjs test/connectivity-runtime-convergence.test.mjs test/generate-system-integration-certificate.test.mjs test/verify-system-integration-certificate.test.mjs test/certification-negative-controls.test.mjs",
    "test:certified": "node scripts/run-certified-tests.mjs",
    "audit:manifest": "node scripts/generate-certification-manifest.mjs",
    "audit:connectivity:static": "node scripts/connectivity-compiler.mjs",
    "audit:canary:verify": "node scripts/canary-campaign-verifier.mjs",
    "audit:convergence:test": "node scripts/connectivity-runtime-convergence.mjs --mode test",
    "audit:convergence:certify": "node scripts/connectivity-runtime-convergence.mjs --mode certify",
    "audit:certificate": "node scripts/generate-system-integration-certificate.mjs",
    "audit:certificate:verify": "node scripts/verify-system-integration-certificate.mjs",
    "audit:c1": "node scripts/audit-single-authority-door.mjs",
    "test:all": "npm run test:core && npm run test:intelligence && npm run test:platform && npm run test:terminal",
    "research:manifest": "node scripts/research-export-manifest.mjs",
    "test": "npm run build:engine && npm run test:core && npm run test:intelligence && npm run test:platform && npm run test:terminal",
    "start": "node --env-file=.env dist/fusion.js",
    "check": "node --env-file=.env dist/fusion.js --check",
    "ui:demo": "node dist/ui-demo.js",
    "app": "node dist/app.js",
    "dev": "npm --prefix terminal run dev",
    "shadow": "node scripts/shadow-runner.mjs",
    "test:in-process": "node scripts/test-in-process.mjs",
    "test:edge-cases": "node scripts/test-edge-cases.mjs",
    "test:probe": "node scripts/test-bridge-reachability.mjs",
    "audit:synthetic": "node scripts/test-synthetic-session.mjs sessions/synthetic-test.jsonl && node scripts/verify-replay.mjs sessions/synthetic-test.jsonl && node scripts/shadow-analysis.mjs sessions/synthetic-test.jsonl",
    "audit:replay": "node scripts/audit-populated-replay.mjs",
    "audit:god-tier": "node scripts/god-tier-25-audit.mjs",
    "bridge": "node scripts/live-market-bridge.mjs",
    "test:offline": "npm run test:in-process && npm run test:edge-cases && npm run audit:synthetic",
    "start:cloud": "node scripts/cloud-trading-runner.mjs",
    "server": "node terminal/server.mjs"
  },
  "dependencies": {
    "@pump-fun/pump-sdk": "2.0.0",
    "@solana/web3.js": "1.98.4",
    "@solana/spl-token": "0.4.14",
    "@coral-xyz/anchor": "0.31.1",
    "@triton-one/yellowstone-grpc": "4.0.2",
    "bn.js": "5.2.5",
    "bs58": "6.0.0",
    "ws": "8.21.3",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "@types/bn.js": "5.2.0",
    "@types/ws": "8.18.1",
    "typescript": "5.9.2"
  }
}
