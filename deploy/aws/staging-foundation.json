{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "SYLPH staging signing foundation. No application deployment or live trading authorization.",
  "Resources": {
    "SigningKey": {
      "Type": "AWS::KMS::Key",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": "SYLPH staging Solana Ed25519 signer; never share with production",
        "KeySpec": "ECC_NIST_EDWARDS25519",
        "KeyUsage": "SIGN_VERIFY",
        "Origin": "AWS_KMS",
        "Enabled": true,
        "PendingWindowInDays": 30,
        "Tags": [{"Key": "Application", "Value": "SYLPH"}, {"Key": "Environment", "Value": "staging"}],
        "KeyPolicy": {
          "Version": "2012-10-17",
          "Statement": [{
            "Sid": "AccountAdministrationAndIamDelegation",
            "Effect": "Allow",
            "Principal": {"AWS": {"Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:root"}},
            "Action": "kms:*",
            "Resource": "*"
          }]
        }
      }
    },
    "SignerTaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [{"Effect": "Allow", "Principal": {"Service": "ecs-tasks.amazonaws.com"}, "Action": "sts:AssumeRole",
            "Condition": {"StringEquals": {"aws:SourceAccount": {"Ref": "AWS::AccountId"}},
              "ArnLike": {"aws:SourceArn": {"Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:*"}}}}]
        },
        "Policies": [{"PolicyName": "PinnedStagingEd25519Key", "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {"Effect": "Allow", "Action": ["kms:GetPublicKey", "kms:DescribeKey"], "Resource": {"Fn::GetAtt": ["SigningKey", "Arn"]}},
            {"Effect": "Allow", "Action": "kms:Sign", "Resource": {"Fn::GetAtt": ["SigningKey", "Arn"]},
              "Condition": {"StringEquals": {"kms:SigningAlgorithm": "ED25519_SHA_512", "kms:MessageType": "RAW"}}}
          ]
        }}]
      }
    },
    "TradingTaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [{"Effect": "Allow", "Principal": {"Service": "ecs-tasks.amazonaws.com"}, "Action": "sts:AssumeRole",
            "Condition": {"StringEquals": {"aws:SourceAccount": {"Ref": "AWS::AccountId"}},
              "ArnLike": {"aws:SourceArn": {"Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:*"}}}}]
        },
        "Policies": [{"PolicyName": "NoDirectCustody", "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [{"Effect": "Deny", "Action": ["kms:Sign", "kms:Decrypt", "kms:GenerateDataKey*", "sts:AssumeRole", "iam:PassRole"], "Resource": "*"}]
        }}]
      }
    }
  },
  "Outputs": {
    "SigningKeyArn": {"Value": {"Fn::GetAtt": ["SigningKey", "Arn"]}},
    "SignerTaskRoleArn": {"Value": {"Fn::GetAtt": ["SignerTaskRole", "Arn"]}},
    "TradingTaskRoleArn": {"Value": {"Fn::GetAtt": ["TradingTaskRole", "Arn"]}}
  }
}
